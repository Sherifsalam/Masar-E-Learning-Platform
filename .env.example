PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/Masar

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# QR check-in codes rotate/expire after this many seconds
QR_SESSION_TTL_SECONDS=900

# Email (used by report module - optional, safe to leave blank in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Masar <no-reply@masar.app>"
